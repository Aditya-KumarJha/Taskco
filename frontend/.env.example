# ========================================
# TASKCO FRONTEND - ENVIRONMENT VARIABLES
# ========================================

# ---------------------------------------
# API Configuration
# ---------------------------------------
# Backend API base URL
# Development: http://localhost:3000/api
# Production: https://your-api-domain.com/api
VITE_API_URL=http://localhost:3000/api

# API request timeout in milliseconds
VITE_API_TIMEOUT=10000

# ---------------------------------------
# OAuth Redirect URLs
# ---------------------------------------
# These must match your backend OAuth callback URLs
# Get these from your backend .env configuration

# Google OAuth redirect URI
VITE_GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google

# GitHub OAuth redirect URI
VITE_GITHUB_REDIRECT_URI=http://localhost:3000/api/auth/github

# ---------------------------------------
# Application Configuration
# ---------------------------------------
# Application name displayed in UI
VITE_APP_NAME=Taskco

# Application version
VITE_APP_VERSION=1.0.0

# Application description
VITE_APP_DESCRIPTION=Modern Task Management Application

# ---------------------------------------
# Feature Flags
# ---------------------------------------
# Enable/disable features for development or A/B testing

# Enable notification system
VITE_ENABLE_NOTIFICATIONS=true

# Enable analytics tracking (Google Analytics, etc.)
VITE_ENABLE_ANALYTICS=false

# Enable service worker for PWA
VITE_ENABLE_SERVICE_WORKER=false

# Enable dark mode feature
VITE_ENABLE_DARK_MODE=false

# Enable experimental features
VITE_ENABLE_EXPERIMENTAL=false

# ---------------------------------------
# CDN & External Services (Optional)
# ---------------------------------------
# ImageKit public URL endpoint (for image optimization)
# VITE_IMAGEKIT_URL=https://ik.imagekit.io/your-id

# Google Analytics ID
# VITE_GA_TRACKING_ID=G-XXXXXXXXXX

# Sentry DSN for error tracking
# VITE_SENTRY_DSN=https://xxxxx@sentry.io/xxxxx

# ---------------------------------------
# Development Settings
# ---------------------------------------
# Enable debug mode (shows detailed logs)
VITE_DEBUG_MODE=false

# API mock mode (use mock data instead of real API)
VITE_USE_MOCK_API=false

# Show development tools in production
VITE_SHOW_DEV_TOOLS=false

# ---------------------------------------
# Performance Settings
# ---------------------------------------
# Number of tasks to load per page
VITE_TASKS_PER_PAGE=10

# Number of notifications to load per page
VITE_NOTIFICATIONS_PER_PAGE=20

# Image upload max size in MB
VITE_MAX_IMAGE_SIZE_MB=5

# Cache timeout in milliseconds (5 minutes)
VITE_CACHE_TIMEOUT=300000

# ---------------------------------------
# UI Configuration
# ---------------------------------------
# Default theme (light/dark)
VITE_DEFAULT_THEME=light

# Animation duration in milliseconds
VITE_ANIMATION_DURATION=300

# Toast notification duration in milliseconds
VITE_TOAST_DURATION=3000

# ---------------------------------------
# Social Media Links (for footer/about)
# ---------------------------------------
VITE_GITHUB_URL=https://github.com/Aditya-KumarJha/Taskco
VITE_TWITTER_URL=
VITE_LINKEDIN_URL=

# ---------------------------------------
# Contact Information
# ---------------------------------------
VITE_SUPPORT_EMAIL=support@taskco.com
VITE_CONTACT_EMAIL=contact@taskco.com

# ---------------------------------------
# SETUP INSTRUCTIONS
# ---------------------------------------

# 1. Copy this file to .env
#    cp .env.example .env

# 2. Update VITE_API_URL with your backend URL
#    Development: http://localhost:3000/api
#    Production: https://your-backend-url.com/api

# 3. Configure OAuth redirect URLs to match backend

# 4. Enable/disable features as needed

# 5. Never commit .env to version control
#    Ensure .env is in .gitignore

# ---------------------------------------
# NOTES
# ---------------------------------------

# - All Vite env variables must be prefixed with VITE_
# - Variables are exposed to the client-side code
# - Do NOT store sensitive secrets here (API keys, tokens)
# - Sensitive data should be handled by the backend
# - Changes require dev server restart (npm run dev)

# ---------------------------------------
# PRODUCTION DEPLOYMENT
# ---------------------------------------

# For production deployment, set these variables in your hosting provider:
# - Vercel: Project Settings > Environment Variables
# - Netlify: Site Settings > Build & Deploy > Environment
# - GitHub Pages: Use GitHub Secrets for build-time variables

# Required for Production:
# ✓ VITE_API_URL (your production backend URL)
# ✓ VITE_GOOGLE_REDIRECT_URI (production OAuth URL)
# ✓ VITE_GITHUB_REDIRECT_URI (production OAuth URL)
# ✓ VITE_ENABLE_NOTIFICATIONS=true
# ✓ VITE_ENABLE_ANALYTICS=true (optional)
