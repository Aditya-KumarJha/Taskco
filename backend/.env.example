# ========================================
# TASKCO BACKEND - ENVIRONMENT VARIABLES
# ========================================

# ---------------------------------------
# Server Configuration
# ---------------------------------------
NODE_ENV=development
PORT=3000

# ---------------------------------------
# Database Configuration
# ---------------------------------------
# Development Database
MONGODB_URI=mongodb://localhost:27017/taskco

# Test Database (for running tests)
MONGODB_TEST_URI=mongodb://localhost:27017/taskco-test

# Production Database (MongoDB Atlas)
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/taskco?retryWrites=true&w=majority

# ---------------------------------------
# JWT Configuration
# ---------------------------------------
# Secret key for JWT token signing (CHANGE THIS IN PRODUCTION!)
# Generate a secure random string: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-min-32-characters-change-this-in-production

# JWT expiration time (7d = 7 days, 24h = 24 hours, 60m = 60 minutes)
JWT_EXPIRE=7d

# Cookie expiration in days
JWT_COOKIE_EXPIRE=7

# ---------------------------------------
# OAuth - Google Authentication
# ---------------------------------------
# Get credentials from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# ---------------------------------------
# OAuth - GitHub Authentication
# ---------------------------------------
# Get credentials from: https://github.com/settings/developers
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_CALLBACK_URL=http://localhost:3000/api/auth/github/callback

# ---------------------------------------
# Frontend Application URL
# ---------------------------------------
# URL of your frontend application (for OAuth redirects and CORS)
CLIENT_URL=http://localhost:5173

# Production:
# CLIENT_URL=https://yourdomain.com

# ---------------------------------------
# Email Configuration (SMTP)
# ---------------------------------------
# Gmail SMTP Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-gmail-app-specific-password

# Alternative SMTP providers:
# SendGrid: EMAIL_HOST=smtp.sendgrid.net, EMAIL_PORT=587
# Mailgun: EMAIL_HOST=smtp.mailgun.org, EMAIL_PORT=587
# Outlook: EMAIL_HOST=smtp-mail.outlook.com, EMAIL_PORT=587

# Email sender address
EMAIL_FROM=noreply@taskco.com

# For Gmail:
# 1. Enable 2-Factor Authentication
# 2. Generate App Password: https://myaccount.google.com/apppasswords
# 3. Use the generated password in EMAIL_PASS

# ---------------------------------------
# ImageKit CDN Configuration
# ---------------------------------------
# Get credentials from: https://imagekit.io/dashboard/developer
IMAGEKIT_PUBLIC_KEY=your-imagekit-public-key
IMAGEKIT_PRIVATE_KEY=your-imagekit-private-key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your-imagekit-id

# Note: Sign up at https://imagekit.io for free CDN service

# ---------------------------------------
# RabbitMQ Configuration
# ---------------------------------------
# Local RabbitMQ
RABBITMQ_URL=amqp://localhost:5672

# Cloud RabbitMQ (CloudAMQP)
# RABBITMQ_URL=amqps://username:password@your-cloudamqp-server.com/virtual-host

# Queue name for notifications
NOTIFICATION_QUEUE=notifications

# ---------------------------------------
# Security Configuration
# ---------------------------------------
# Bcrypt salt rounds (10-12 recommended)
BCRYPT_SALT_ROUNDS=10

# OTP expiration time in minutes
OTP_EXPIRE_MINUTES=10

# ---------------------------------------
# Rate Limiting Configuration
# ---------------------------------------
# Time window in milliseconds (900000ms = 15 minutes)
RATE_LIMIT_WINDOW_MS=900000

# Maximum requests per time window
RATE_LIMIT_MAX_REQUESTS=100

# ---------------------------------------
# File Upload Configuration
# ---------------------------------------
# Maximum file size in bytes (5MB = 5242880 bytes)
MAX_FILE_SIZE=5242880

# Allowed file types (comma-separated)
ALLOWED_FILE_TYPES=image/jpeg,image/jpg,image/png,image/webp

# ---------------------------------------
# Logging Configuration
# ---------------------------------------
# Log level: error, warn, info, http, verbose, debug, silly
LOG_LEVEL=info

# Production:
# LOG_LEVEL=error

# ---------------------------------------
# SETUP INSTRUCTIONS
# ---------------------------------------

# 1. Copy this file to .env
#    cp .env.example .env

# 2. Fill in all the required values
#    - Change JWT_SECRET to a secure random string
#    - Set up Google OAuth credentials
#    - Set up GitHub OAuth credentials
#    - Configure email SMTP settings
#    - Set up ImageKit account
#    - Configure RabbitMQ connection

# 3. Never commit .env to version control
#    - Ensure .env is in .gitignore

# 4. For production deployment:
#    - Use strong, unique values
#    - Enable SSL/TLS
#    - Use environment-specific values
#    - Store secrets in secure vault (AWS Secrets Manager, etc.)
