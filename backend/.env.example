# Server
PORT=3000
NODE_ENV=development

# URLs
BACKEND_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# Database
MONGODB_URI=YOUR_DATABASE_URI_HERE

# Auth / JWT
JWT_SECRET=your_jwt_secret_key_here
REFRESH_TOKEN=your_refresh_token_secret_key_here

# OAuth - GitHub
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# OAuth - Google
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Email (SMTP)
EMAIL_USER=your_email_user_here

# Email Service (Resend)
RESEND_API_KEY=your_resend_api_key_here

# ImageKit
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key_here
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key_here
IMAGEKIT_URL_ENDPOINT=your_imagekit_url_endpoint_here

# RabbitMQ
RABBITMQ_URL=your_rabbitmq_url_here

# Redis (Optional - for caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Admin Configuration
ADMIN_EMAIL=admin@taskco.com
ADMIN_PASSWORD=Admin@123456
